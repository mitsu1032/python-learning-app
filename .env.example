# ===========================================
# Python学習支援アプリケーション - 環境変数テンプレート
# ===========================================
# このファイルを .env にコピーして使用してください
# cp .env.example .env
# 本番環境では .env をバージョン管理に含めないでください

# ===========================================
# API設定
# ===========================================
# Anthropic Claude API Key
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_api_key_here

# APIモデル（省略可能）
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===========================================
# アプリケーション設定
# ===========================================
# 環境: development, staging, production
APP_ENV=development

# デバッグモード（本番環境ではfalseに設定）
DEBUG=true

# フロントエンドポート
FRONTEND_PORT=80

# データベースパス
DATABASE_PATH=./data/learning.db

# ===========================================
# セキュリティ設定
# ===========================================
# CORS許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# レート制限（1分あたりのリクエスト数）
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ===========================================
# ログ設定
# ===========================================
# ログレベル: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===========================================
# キャッシュ設定
# ===========================================
# キャッシュTTL（秒）
CACHE_TTL=3600

# キャッシュ最大サイズ
CACHE_MAX_SIZE=1000
